# Nach .env kopieren und eigene Werte eintragen (.env wird nicht eingecheckt).

# Gemini API-Key aus Google AI Studio (https://aistudio.google.com -> "Get API key")
GEMINI_API_KEY=your-gemini-api-key

# Gemini-Modell (wird nur hier festgelegt), siehe https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.5-flash-lite

# Key für den eigenen LiteLLM-Proxy (frei wählbar, muss mit "sk-" beginnen)
OPENAI_API_KEY=sk-homework2-change-me

# LiteLLM-Proxy aus Sicht von main.py
LITELLM_URL=http://localhost:4000
